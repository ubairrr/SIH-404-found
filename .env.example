# CaseVault environment variables. Copy to .env and fill in real values —
# .env is gitignored and never committed. See .planning/phases/01-.../01-RESEARCH.md
# Code Examples §1 for the hosted-vs-offline split this is derived from.

# --- Database (required, both hosted and offline modes) ---
# Hosted (Vercel + Supabase): pooled connection (port 6543, pgbouncer=true)
# for the running app, direct connection (port 5432) for migrations only.
# Copy the exact strings from that Supabase project's dashboard
# (Database -> Connection string) — do not hand-type based on this template.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Offline (Docker Postgres + local disk) — same two variables, pointed at
# the local docker-compose Postgres instance instead:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casevault"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/casevault"

# --- Session (required) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="<32-byte base64 secret>"

# --- Demo mode (optional) ---
# When "true", the login page shows a "Demo accounts" panel (D-17).
DEMO_MODE="true"

# --- Storage (required, hosted mode) ---
# Selects SupabaseStorageAdapter. Any other value selects LocalDiskStorageAdapter
# (see .env.local.example for the offline path).
STORAGE_DRIVER="supabase"

# SUPABASE_URL must be EXACTLY the project API URL from Supabase Dashboard ->
# Project Settings -> API (Data API): https://<project-ref>.supabase.co
# No trailing slash. No path suffix — NOT .../rest/v1, NOT .../storage/v1,
# NOT .../storage/v1/s3, and NOT the dashboard/project-management URL
# (supabase.com/dashboard/project/...). A wrong value here surfaces as
# "Invalid path specified in request URL" from Supabase Storage.
SUPABASE_URL="https://<project-ref>.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY — server-only, never expose to the client.
# CaseVault expects the LEGACY JWT-format service_role key, which starts
# with "eyJ". Supabase's newer non-JWT key format starts with "sb_secret_"
# and has documented supabase-js/storage-js compatibility issues with
# admin/service-role operations (including signed upload URLs) — do not use
# it here. If uploads fail with a generic "Couldn't prepare the upload"
# error, regenerate/copy the legacy JWT service_role key fresh from
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY="<service-role key — server-only, never expose to the client>"
